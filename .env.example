
NODE_ENV=development
PORT=4000
CLIENT_PORT=5173
PUBLIC_URL=http://localhost:5173

# Database
PGHOST=localhost
PGPORT=5455
PGUSER=matcha
PGPASSWORD=matcha
PGDATABASE=matcha

# Secrets: regenerate with `make secrets`
SESSION_SECRET=change-me-please-32-chars-minimum-000
TOKEN_PEPPER=change-me-too-32-chars-minimum-00000

# Outgoing mail. Defaults point at the MailHog container started by `make db`.
# Leave SMTP_HOST empty to dump mails into server/tmp/mail instead.
SMTP_HOST=localhost
SMTP_PORT=1085
# Web inbox that catches every email in development
MAILUI_PORT=8085
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Matcha <no-reply@matcha.local>

# Optional social sign in (bonus). Leave blank to hide the buttons.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google:  https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# Seeding
SEED_USERS=520
SEED_PASSWORD=Matcha!2024seed
