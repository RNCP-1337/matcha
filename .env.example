SMTP_PORT=1085

# Web inbox that catches every email in development
MAILUI_PORT=8085
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Matcha <no-reply@matcha.local>


# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# Seeding
SEED_USERS=520
SEED_PASSWORD=Matcha!2024seed
