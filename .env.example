
NODE_ENV=development
PORT=4000
CLIENT_PORT=5173
PUBLIC_URL=http://localhost:5173

# Database
PGHOST=localhost
PGPORT=5455
PGUSER=matcha
PGPASSWORD=matcha
PGDATABASE=matcha

# Secrets: regenerate with `make secrets`
SESSION_SECRET=change-me-please-32-chars-minimum-000
TOKEN_PEPPER=change-me-too-32-chars-minimum-00000

# Outgoing mail

